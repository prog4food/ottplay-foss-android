{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>victron-venus/venus-os-ci-toolkit:renovate-ci"],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "npm",
    "cargo"
  ],
  "packageRules": [
    {
      "description": "Dependabot retains general npm ownership; Cargo updates require a reviewed native migration.",
      "matchManagers": ["npm", "cargo"],
      "enabled": false
    },
    {
      "description": "Update both updater bindings together; 2.13 requires migrating the patched native WebView stack.",
      "matchManagers": ["npm", "cargo"],
      "matchPackageNames": [
        "@tauri-apps/plugin-updater",
        "tauri-plugin-updater"
      ],
      "matchFileNames": ["package.json", "src-tauri/Cargo.toml"],
      "enabled": true,
      "groupName": "Tauri updater bindings",
      "groupSlug": "tauri-updater",
      "minimumGroupSize": 2,
      "groupSingleUpdates": false,
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "rangeStrategy": "pin",
      "allowedVersions": ">=2.12.0 <2.13.0",
      "automerge": false
    }
  ]
}
