  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**",
      "devices/**",
      "biome.json",
      "package.json",
      "tsconfig.json",
      "!index.html",
      "!dist/**",
      "!fonts/**",
      "!js/**",
      "!tests/fixtures/**",
      "!node_modules/**",
      "!ios/**",
      "!android/**",
      "!src-tauri/**",
      "!vendor/glib-0.18.5/.cargo_vcs_info.json",
      "!vendor/tao-0.35.3/**",
      "!vendor/wry-0.55.1/**",
      "!vendor/ottplay-core.js",
      "!vendor/hosted-epg/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 4
  },
  "linter": {
    "enabled": false,
    "rules": {
      "correctness": {
        "noInnerDeclarations": "off",
        "noUnusedVariables": "off",
        "noUnusedFunctionParameters": "off",
        "useParseIntRadix": "off",
        "noUnusedImports": "off",
        "noSelfAssign": "off"
      },
      "complexity": {
        "useArrowFunction": "off",
        "noUselessSwitchCase": "off",
        "useOptionalChain": "off",
        "noArguments": "off",
        "noForEach": "off",
        "noExcessiveCognitiveComplexity": "off"
      },
      "style": {
        "useTemplate": "off",
        "useNodejsImportProtocol": "off",
        "useConst": "off",
        "noNonNullAssertion": "off",
        "useBlockStatements": "off",
        "useNumericSeparators": "off",
        "noNegationElse": "off",
        "useConsistentObjectDefinitions": "off",
        "useCollapsedElseIf": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "useDefaultSwitchClauseLast": "off",
        "noDoubleEquals": "off",
        "noGlobalIsNan": "off",
        "noPrototypeBuiltins": "off",
        "noDocumentCookie": "off",
        "noAssignInExpressions": "off",
        "noFallthroughSwitchClause": "off",
        "noRedeclare": "off",
        "noVar": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["contracts/ottplay-wire-v1.json"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
