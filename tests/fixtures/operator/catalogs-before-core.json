            "time_to": 0,
            "token": "fixture"
          }
        },
        "groups": {
          "News": [
            "a"
          ],
          "Sports": [
            "b"
          ]
        },
        "groupOrder": [
          "News",
          "Sports"
        ],
        "epg": {
          "retained": [
            {
              "name": "retained"
            }
          ]
